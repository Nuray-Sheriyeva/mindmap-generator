# ---------------------------------------------------------------------------
# LLM provider (required for real generation)
# ---------------------------------------------------------------------------
# openai = any OpenAI-compatible chat-completions endpoint.
# mock   = offline heuristic demo mode (no API key, not a real LLM).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
API_KEY=
# json_schema (recommended, structured output) or json_object (broad fallback).
LLM_JSON_MODE=json_schema
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=4
LLM_MAX_OUTPUT_TOKENS=4096

# Optional alias for API_KEY:
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Upload / document limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PAGES=500
MIN_EXTRACTABLE_CHARS=40

# ---------------------------------------------------------------------------
# Mind map shape
# ---------------------------------------------------------------------------
DEFAULT_MAX_DEPTH=3
MAX_DEPTH_LIMIT=3
DEFAULT_MAX_BRANCHES=6
MAX_BRANCHES_LIMIT=12
MAX_CHILDREN=6
MAX_REPAIR_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Chunking (characters, not tokens)
# ---------------------------------------------------------------------------
CHUNK_CHARS=6000
CHUNK_OVERLAP_CHARS=300
SINGLE_CALL_CHAR_LIMIT=12000
MAX_INPUT_CHARS=48000

# ---------------------------------------------------------------------------
# Jobs / cache
# ---------------------------------------------------------------------------
JOB_TTL_MINUTES=60
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=64

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# JSON list (pydantic-settings parses this form).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
ENVIRONMENT=development
