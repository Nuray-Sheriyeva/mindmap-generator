# Leave empty to use the Vite dev proxy (recommended for local development).
# Set to the backend origin when the frontend is served from another host,
# e.g. VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=

# Optional: backend target for the Vite dev proxy.
# VITE_BACKEND_URL=http://127.0.0.1:8000
